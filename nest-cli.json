{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/booking-service/src",
  "compilerOptions": {
    "deleteOutDir": true
  },
  "monorepo": true,
  "root": "apps/booking-service",
  "projects": {
    "booking-service": {
      "type": "application",
      "root": "apps/booking-service",
      "entryFile": "main",
      "sourceRoot": "apps/booking-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/booking-service/tsconfig.app.json"
      }
    },
    "cloudbeds-integration-service": {
      "type": "application",
      "root": "apps/cloudbeds-integration-service",
      "entryFile": "main",
      "sourceRoot": "apps/cloudbeds-integration-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/cloudbeds-integration-service/tsconfig.app.json"
      }
    },
    "payment-policy-service": {
      "type": "application",
      "root": "apps/payment-policy-service",
      "entryFile": "main",
      "sourceRoot": "apps/payment-policy-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/payment-policy-service/tsconfig.app.json"
      }
    },
    "notification-service": {
      "type": "application",
      "root": "apps/notification-service",
      "entryFile": "main",
      "sourceRoot": "apps/notification-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification-service/tsconfig.app.json"
      }
    },
    "audit-service": {
      "type": "application",
      "root": "apps/audit-service",
      "entryFile": "main",
      "sourceRoot": "apps/audit-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/audit-service/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "shared-dtos": {
      "type": "library",
      "root": "libs/shared-dtos",
      "entryFile": "index",
      "sourceRoot": "libs/shared-dtos/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared-dtos/tsconfig.lib.json"
      }
    },
    "shared-events": {
      "type": "library",
      "root": "libs/shared-events",
      "entryFile": "index",
      "sourceRoot": "libs/shared-events/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared-events/tsconfig.lib.json"
      }
    }
  }
}
