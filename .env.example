# Database Configuration
DATABASE_URL=""

# Application Configuration
NODE_ENV=development
PORT=3000
APP_NAME=Hostelworld Payment Automation

# Cloudbed API Configuration
CLOUDBED_API_URL=https://api.cloudbeds.com
CLOUDBED_API_KEY=your_cloudbed_api_key
CLOUDBED_PROPERTY_ID=317803

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email Addresses
SUPPORT_EMAIL=support@yourhotel.com
MANAGER_EMAIL=manager@yourhotel.com
FROM_EMAIL=noreply@yourhotel.com

# Payment Gateway Configuration
PAYMENT_GATEWAY_URL=https://api.payment-gateway.com
PAYMENT_GATEWAY_API_KEY=your_payment_gateway_key
PAYMENT_GATEWAY_MERCHANT_ID=your_merchant_id

# Risk Assessment Configuration
RISK_OCCUPANCY_THRESHOLD=50
SAME_DAY_PAYMENT_DEADLINE_HOURS=1
FLEXIBLE_BOOKING_REMINDER_DAYS=2
HIGH_RISK_ROOM_THRESHOLD=4

# Legacy (fallback)
HIGH_RISK_GUEST_THRESHOLD=4

# Retry Configuration
PAYMENT_MAX_RETRIES=3
EMAIL_MAX_RETRIES=3
RISKY_BOOKING_WAIT_HOURS=24
NOT_RISKY_BOOKING_WAIT_HOURS=2

# Logging Configuration
LOG_LEVEL=debug
LOG_RETENTION_DAYS=15
LOG_MAX_SIZE=20m
LOG_MAX_FILES=15d

# Scheduler Configuration
ENABLE_SCHEDULER=true
SCHEDULER_CHECK_INTERVAL_MINUTES=15
