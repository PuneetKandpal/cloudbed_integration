{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@hostelworld/common": ["libs/common/src"],
      "@hostelworld/common/*": ["libs/common/src/*"],
      "@hostelworld/database": ["libs/database/src"],
      "@hostelworld/database/*": ["libs/database/src/*"],
      "@hostelworld/shared-dtos": ["libs/shared-dtos/src"],
      "@hostelworld/shared-dtos/*": ["libs/shared-dtos/src/*"],
      "@hostelworld/shared-events": ["libs/shared-events/src"],
      "@hostelworld/shared-events/*": ["libs/shared-events/src/*"]
    }
  }
}
